# =============================================================================
# fl-ass-ist — environment template
# =============================================================================
# This file IS committed. It must never contain real values.
# Copy it to `.env` (gitignored) and fill that in:  cp .env.example .env
# Validate at any time with:                        uv run scripts/verify_env.py
# =============================================================================

# --- ESPN authentication -----------------------------------------------------
# Chrome/Safari DevTools -> Application -> Cookies -> https://fantasy.espn.com
# Copy the values EXACTLY. Do not URL-decode espn_s2; keep the braces on SWID.
ESPN_S2=''
ESPN_SWID='{00000000-0000-0000-0000-000000000000}'

# --- Season ------------------------------------------------------------------
FF_SEASON='2026'

# --- Leagues -----------------------------------------------------------------
# Short keys used in tool calls, e.g. get_start_sit_slate("main", week=3).
# Lowercase, comma-separated. Each key needs a matching FF_LEAGUE_<KEY>_* block.
FF_LEAGUE_KEYS='main,dynasty,work'

# LEAGUE_ID  -> the leagueId=XXXXXXX number in your ESPN league URL
# TEAM_ID    -> the teamId=N number when you're viewing YOUR team (optional)
# LABEL      -> friendly name for briefs (optional; falls back to ESPN's name)
FF_LEAGUE_MAIN_ID=''
FF_LEAGUE_MAIN_TEAM_ID=''
FF_LEAGUE_MAIN_LABEL=''

FF_LEAGUE_DYNASTY_ID=''
FF_LEAGUE_DYNASTY_TEAM_ID=''
FF_LEAGUE_DYNASTY_LABEL=''

FF_LEAGUE_WORK_ID=''
FF_LEAGUE_WORK_TEAM_ID=''
FF_LEAGUE_WORK_LABEL=''

# --- Local runtime -----------------------------------------------------------
FF_CACHE_DIR='data/cache'
FF_LOG_LEVEL='INFO'

# --- Phase 3: remote MCP server ----------------------------------------------
# Bearer token clients must present. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FF_MCP_BEARER_TOKEN=''

# --- Optional paid sources ---------------------------------------------------
# Leave blank unless/until you subscribe. Open-Meteo and the Sleeper API
# need no keys, so they are deliberately absent from this file.
FANTASYPROS_API_KEY=''
